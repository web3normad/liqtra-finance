# Private key for deployment (DO NOT COMMIT REAL KEY)
PRIVATE_KEY=your_private_key_here

# RPC URLs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
# Or use Alchemy/Infura: https://base-sepolia.infura.io/v3/YOUR_PROJECT_ID

# Etherscan API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional: If you want to use existing USDC instead of deploying mock
USDC_ADDRESS=

# Network Configuration
CHAIN_ID=84532

# Agent Configuration
AGENT_PRIVATE_KEY=your_agent_private_key_here
VAULT_CONTRACT_ADDRESS=your_vault_address_here

# OpenAI API (for AI chatbot)
OPENAI_API_KEY=your_openai_api_key_here

# JWT Secret (for backend authentication)
JWT_SECRET=your_random_secret_string_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (if using PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
